---
import CesiumTilesetDemo from "../CesiumTilesetDemo";
import type { Language } from "../../i18n/utils";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="mdx-media not-prose my-8 max-w-[85rem]">
  <CesiumTilesetDemo client:visible lang={lang} />
</div>

<style>
  :global(.cesium-tileset-demo-root),
  :global(.cesium-tileset-demo-root .cesium-viewer),
  :global(.cesium-tileset-demo-root .cesium-viewer-cesiumWidgetContainer),
  :global(.cesium-tileset-demo-root .cesium-widget),
  :global(.cesium-tileset-demo-root canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
